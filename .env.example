# Copiar a .env y completar. Cada entorno (producción / prueba) es un despliegue con su propia URI.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base_de_datos>?retryWrites=true&w=majority
JWT_SECRET=
# Prefijo de las rutas de la API (ej: /api)
ROUTE=
# URL(s) del frontend permitidas por CORS, separadas por coma (ej: https://midominio.com,https://app.vercel.app)
BASE_URL=
PORT=4000
NODE_ENV=development
# Cantidad de proxies delante del backend (Traefik en Coolify, el balanceador de Render).
TRUST_PROXY=1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Datos del negocio que aparecen en los PDFs. EMPRESA_CONDICION_IVA = Monotributista o Exento
# hace que las ventas se facturen siempre con C.
EMPRESA_RAZON_SOCIAL=
EMPRESA_CUIT=
EMPRESA_CONDICION_IVA=
EMPRESA_INICIO_ACTIVIDADES=
EMPRESA_PAIS=
EMPRESA_PROVINCIA=
EMPRESA_LOCALIDAD=
EMPRESA_BARRIO=
EMPRESA_CALLE=
EMPRESA_ALTURA=
EMPRESA_TELEFONO=
EMPRESA_EMAIL=

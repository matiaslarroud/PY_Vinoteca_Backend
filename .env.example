# Copiar a .env y completar. Cada entorno (producción / prueba) es un despliegue con su propia URI.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base_de_datos>?retryWrites=true&w=majority
JWT_SECRET=
# Prefijo de las rutas de la API (ej: /api)
ROUTE=
# URL(s) del frontend permitidas por CORS, separadas por coma (ej: https://midominio.com,https://app.vercel.app)
BASE_URL=
PORT=4000
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
